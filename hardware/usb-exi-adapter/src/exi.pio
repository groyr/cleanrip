;
; usb-exi-adapter - exi.pio
;
; EXI 1bit モードのスレーブを PIO で実装する。
;   - CLK は GC（マスタ）が駆動する。CS は CPU 側でポーリングする。
;   - データは MSB ファースト。
;
; 重要: CLK のピン番号はこのファイルにリテラルで埋め込んでいる。
;       exi_slave.h の EXI_PIN_CLK と一致させること（C 側で static チェックあり）。
;
; ライセンス: MIT
;

; ------------------------------------------------------------------
; 受信（GC → アダプタ）: CLK 立ち上がりで DATA をサンプル
;   in pins は in_base（= DATA ピン）を読む。8bit で autopush。
; ------------------------------------------------------------------
.program exi_in
.wrap_target
    wait 1 gpio 3       ; CLK 立ち上がり待ち
    in pins, 1          ; DATA をサンプル（in base = DATA）
    wait 0 gpio 3       ; CLK 立ち下がり待ち
.wrap

; ------------------------------------------------------------------
; 送信（アダプタ → GC）: CLK 立ち下がりで DATA を更新
;   out pins は out_base（= DATA ピン）を駆動。8bit で autopull。
; ------------------------------------------------------------------
.program exi_out
.wrap_target
    wait 0 gpio 3       ; CLK 立ち下がり（= Low）待ち
    out pins, 1         ; DATA を出力（out base = DATA）
    wait 1 gpio 3       ; マスタがサンプルするまで待つ
.wrap
